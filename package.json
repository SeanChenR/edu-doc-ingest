{
  "name": "edu-doc-ingest",
  "version": "0.0.1",
  "private": true,
  "description": "Multi-tenant document ingestion service (NestJS on Bun, PostgreSQL + pgvector + pgmq)",
  "license": "UNLICENSED",
  "author": "",
  "type": "module",
  "scripts": {
    "dev": "bun --bun scripts/dev.ts",
    "dev:api": "bun --bun --watch src/api/main.ts",
    "dev:worker": "bun --bun --watch src/worker/main.ts",
    "test": "bun test",
    "lint": "oxlint --type-aware",
    "lint:fix": "oxlint --type-aware --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "typecheck": "bunx tsc --noEmit",
    "migrate": "bun --bun scripts/migrate.ts",
    "seed": "bun --bun scripts/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/swagger": "^12.0.1",
    "helmet": "^8.3.0",
    "nestjs-pino": "^5.1.0",
    "nestjs-zod": "^5.5.0",
    "pino": "^10.3.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "ulid": "^3.0.2",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.0.1",
    "@types/bun": "^1.4.1",
    "@types/express": "^5.0.6",
    "@types/supertest": "^7.2.1",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "oxlint-tsgolint": "^7.0.2001",
    "supertest": "^7.2.2",
    "typescript": "^6.0.3"
  }
}
