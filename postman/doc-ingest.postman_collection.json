    {
      "name": "5 Retry exhaustion (§9.4)",
      "item": [
        {
          "name": "POST [[FAIL_EMBED]] document → 202",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('202', () => { pm.response.to.have.status(202); pm.collectionVariables.set('fail_job_id', pm.response.json().job_id); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{base_url}}/v1/workspaces/ws_alpha/documents",
            "header": [
              { "key": "Authorization", "value": "Bearer {{api_key_alpha}}" },
              { "key": "Idempotency-Key", "value": "{{idem_key}}-fail" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"name\":\"fail.txt\",\"mime_type\":\"text/plain\",\"size_bytes\":22,\"content_text\":\"[[FAIL_EMBED]] no luck.\"}"
            }
          }
        },
        {
          "name": "GET failing job (poll until failed)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.response.to.have.status(200);",
                  "const j = pm.response.json();",
                  "const tries = Number(pm.collectionVariables.get('poll_tries') || 0);",
                  "if (!['ready','failed'].includes(j.status) && tries < 40) {",
                  "  pm.collectionVariables.set('poll_tries', tries + 1);",
                  "  setTimeout(() => {}, 1000);",
                  "  pm.execution.setNextRequest('GET failing job (poll until failed)');",
                  "} else {",
                  "  pm.collectionVariables.set('poll_tries', 0);",
                  "  pm.test('failed after 3 attempts with a sanitized error', () => {",
                  "    pm.expect(j.status).to.eql('failed');",
                  "    pm.expect(j.attempt).to.eql(3);",
                  "    pm.expect(j.retries_used).to.eql(2);",
                  "    pm.expect(j.last_error.code).to.eql('EMBEDDING_PROVIDER_ERROR');",
                  "    pm.expect(j.last_error.message).to.not.match(/\\n| at |\\/Users|dk_/);",
                  "  });",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{base_url}}/v1/jobs/{{fail_job_id}}",
            "header": [{ "key": "Authorization", "value": "Bearer {{api_key_alpha}}" }]
          }
        }
      ]
    }
