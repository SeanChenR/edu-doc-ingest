{
  "info": {
    "name": "doc-ingest",
    "description": "docs/DESIGN.md §11.3 的流程，加上 §6.3 每個錯誤碼。用 Collection Runner 由上往下跑一次即可；SSE（GET /v1/jobs/:id/events）是長連線，Runner 不適合，請用 scripts/curl-demo.sh 看。\n\n變數：base_url、api_key_alpha、api_key_beta（見 doc-ingest.postman_environment.json）。document_id / job_id / idem_key 由請求的 Tests 腳本自動設定。",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "document_id", "value": "" },
    { "key": "job_id", "value": "" },
    { "key": "idem_key", "value": "" },
    { "key": "fail_job_id", "value": "" }
  ],
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// 每個回應都必須帶 X-Request-Id，且 body 的 request_id 與它相同（§5.1）",
          "const rid = pm.response.headers.get('X-Request-Id');",
          "pm.test('X-Request-Id header present', () => pm.expect(rid).to.match(/^(req_)?[0-9A-Z]{26}$|^[0-9a-f-]{36}$/i));",
          "try {",
          "  const body = pm.response.json();",
          "  const inBody = body.request_id ?? (body.error && body.error.request_id);",
          "  pm.test('body.request_id equals header', () => pm.expect(inBody).to.eql(rid));",
          "} catch (e) {}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "0 Health",
      "item": [
        {
          "name": "GET /health",
          "request": { "method": "GET", "url": "{{base_url}}/health" },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 ok', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().status).to.eql('ok'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /ready",
          "request": { "method": "GET", "url": "{{base_url}}/ready" },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 ok (db + pgmq queue)', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().status).to.eql('ok'); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "1 Create document (§5.3)",
      "item": [
        {
          "name": "POST documents (content_text) → 202",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.collectionVariables.set('idem_key', 'pm-' + Date.now());"]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('202 with ids and status queued', () => {",
                  "  pm.response.to.have.status(202);",
                  "  const b = pm.response.json();",
                  "  pm.expect(b.document_id).to.match(/^doc_/);",
                  "  pm.expect(b.job_id).to.match(/^job_/);",
                  "  pm.expect(b.status).to.eql('queued');",
                  "  pm.collectionVariables.set('document_id', b.document_id);",
                  "  pm.collectionVariables.set('job_id', b.job_id);",
                  "});",
                  "pm.test('not replayed on first call', () => pm.expect(pm.response.headers.has('Idempotent-Replayed')).to.be.false);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{base_url}}/v1/workspaces/ws_alpha/documents",
            "header": [
              { "key": "Authorization", "value": "Bearer {{api_key_alpha}}" },
              { "key": "Idempotency-Key", "value": "{{idem_key}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"name\":\"unit-3.txt\",\"mime_type\":\"text/plain\",\"size_bytes\":11,\"content_text\":\"hello world\",\"metadata\":{\"grade\":5,\"subject\":\"math\"}}"
            }
          }
        },
        {
          "name": "POST same key + same body → 202 replayed",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('202 replay with the same ids', () => {",
                  "  pm.response.to.have.status(202);",
                  "  const b = pm.response.json();",
                  "  pm.expect(b.document_id).to.eql(pm.collectionVariables.get('document_id'));",
                  "  pm.expect(b.job_id).to.eql(pm.collectionVariables.get('job_id'));",
                  "});",
                  "pm.test('Idempotent-Replayed: true', () => pm.expect(pm.response.headers.get('Idempotent-Replayed')).to.eql('true'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{base_url}}/v1/workspaces/ws_alpha/documents",
            "header": [
              { "key": "Authorization", "value": "Bearer {{api_key_alpha}}" },
              { "key": "Idempotency-Key", "value": "{{idem_key}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"name\":\"unit-3.txt\",\"mime_type\":\"text/plain\",\"size_bytes\":11,\"content_text\":\"hello world\",\"metadata\":{\"grade\":5,\"subject\":\"math\"}}"
            }
          }
        },
        {
          "name": "POST same key + different body → 409",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('409 IDEMPOTENCY_KEY_REUSED', () => { pm.response.to.have.status(409); pm.expect(pm.response.json().error.code).to.eql('IDEMPOTENCY_KEY_REUSED'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{base_url}}/v1/workspaces/ws_alpha/documents",
            "header": [
              { "key": "Authorization", "value": "Bearer {{api_key_alpha}}" },
              { "key": "Idempotency-Key", "value": "{{idem_key}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"name\":\"other.txt\",\"mime_type\":\"text/plain\",\"size_bytes\":11,\"content_text\":\"hello world\"}"
            }
          }
        }
      ]
    },
    {
      "name": "2 Query (§5.3, §5.4)",
      "item": [
        {
          "name": "GET job (poll until ready)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 with §5.4 fields', () => {",
                  "  pm.response.to.have.status(200);",
                  "  const j = pm.response.json();",
                  "  pm.expect(j.id).to.eql(pm.collectionVariables.get('job_id'));",
                  "  pm.expect(j).to.have.all.keys('id','workspace_id','document_id','kind','status','progress','attempt','max_attempts','retries_used','last_error','started_at','finished_at','created_at','updated_at','request_id');",
                  "  pm.expect(j.retries_used).to.eql(Math.max(0, j.attempt - 1));",
                  "});",
                  "// worker 還沒做完就等 1 秒再打一次（Runner 會照 setNextRequest 走），最多約 30 次",
                  "const j = pm.response.json();",
                  "const tries = Number(pm.collectionVariables.get('poll_tries') || 0);",
                  "if (!['ready','failed'].includes(j.status) && tries < 30) {",
                  "  pm.collectionVariables.set('poll_tries', tries + 1);",
                  "  setTimeout(() => {}, 1000);",
                  "  pm.execution.setNextRequest('GET job (poll until ready)');",
                  "} else {",
                  "  pm.collectionVariables.set('poll_tries', 0);",
                  "  pm.test('job reached ready', () => pm.expect(j.status).to.eql('ready'));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{base_url}}/v1/jobs/{{job_id}}",
            "header": [{ "key": "Authorization", "value": "Bearer {{api_key_alpha}}" }]
          }
        },
        {
          "name": "GET document → ready with result",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 with §5.3 fields and result', () => {",
                  "  pm.response.to.have.status(200);",
                  "  const d = pm.response.json();",
                  "  pm.expect(d.id).to.eql(pm.collectionVariables.get('document_id'));",
                  "  pm.expect(d.status).to.eql('ready');",
                  "  pm.expect(d.chunk_count).to.be.a('number');",
                  "  pm.expect(d.metadata).to.eql({ grade: 5, subject: 'math' });",
                  "  pm.expect(d.latest_job.id).to.eql(pm.collectionVariables.get('job_id'));",
                  "  pm.expect(d.result.text_preview).to.eql('hello world');",
                  "  pm.expect(d.result.embedding_model).to.eql('mock-1536');",
                  "  pm.expect(d.result.embedding_dimensions).to.eql(1536);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{base_url}}/v1/documents/{{document_id}}",
            "header": [{ "key": "Authorization", "value": "Bearer {{api_key_alpha}}" }]
          }
        }
      ]
    },
