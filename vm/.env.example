# VM 部署用的變數。複製成 vm/.env 再填（.gitignore 已擋 .env；compose 會自動讀同目錄的 .env）。
# 三組密碼與兩把 key 都隨機產生：openssl rand -hex 24

# 對外位址：有 domain 就填 domain（Caddy 自動 HTTPS）；只有 IP 就填 :80
SITE_ADDRESS=doc-ingest.35.187.151.236.nip.io

# PostgreSQL 超級使用者（只有 migrate / seed 用）
POSTGRES_PASSWORD=change-me
# migrate.ts 建的兩個角色
APP_DB_PASSWORD=change-me
WORKER_DB_PASSWORD=change-me

# seed 寫進 api_keys 的兩把 key（DB 只存 SHA-256）。給面試官的就是 ALPHA 這把
SEED_API_KEY_ALPHA=change-me
SEED_API_KEY_BETA=change-me

# 驗收環境刻意保留失敗注入與階段延遲，讓 SSE 進度與重試流程看得到；正式環境改 false / 0
FAILURE_INJECTION=true
STAGE_DELAY_MS=800
